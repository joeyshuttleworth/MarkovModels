Bootstrap: docker
From: ghcr.io/mamba-org/micromamba:latest

%environment
    export PIP_PROGRESS_BAR=on
    export PIP_VERBOSE=1
    export PIP_NO_INPUT=0

%files
. /MarkovModels

%environment
    export OPENSSL_ROOT_DIR="$CONDA_PREFIX"
    export OPENSSL_INCLUDE_DIR="$CONDA_PREFIX/include"
    export OPENSSL_CRYPTO_LIBRARY="$CONDA_PREFIX/lib"	
    export WORK=${SLURM_TMPDIR:-${TMPDIR:-$HOME/work}}
    mkdir -p $WORK/tmp
    export TMPDIR=$WORK/tmp

%post
    export PYTHONNOUSERSITE=1
    export PIP_NO_CACHE_DIR=1
    cd /MarkovModels

    apt update -y
    apt install git uuid-runtime -y
    apt update
    apt install texlive-latex-extra texlive-fonts-recommended dvipng cm-super git -y

    micromamba create -n markovmodels python=3.11 pip setuptools wheel scikit-build -y

    micromamba install -n markovmodels -y -c conda-forge \
        openssl \
    cmake ninja pkg-config \
    make cmake \
    compilers \
    cython \
    meson meson-python \
    scikit-build \
    zlib libffi sqlite bzip2 \
    llvm llvmlite llvmdev numba numpy scipy

    # install conda deps 
    micromamba install -y -n markovmodels -f environment.yml
    export CFLAGS="-Wl,-z,noexecstack"
    export LDFLAGS="-Wl,-z,noexecstack"
    micromamba run -n markovmodels python3 -m pip uninstall numbalsoda -y
    micromamba run -n markovmodels python3 -m pip install --no-binary numbalsoda numbalsoda@git+https://github.com/Nicholaswogan/numbalsoda@main
    micromamba run -n markovmodels python3 -m pip install --no-deps --no-cache-dir .
    micromamba run -n markovmodels python3 -m pip install .
    micromamba run -n markovmodels python3 -m pip uninstall syncropatch_export -y
    micromamba run -n markovmodels python3 -m pip install -e ./syncropatch_export

   apt autoremove -y

  git config --system --add safe.directory /MarkovModels
  chown -R root:root /MarkovModels	

%runscript
    export PYTHONNOUSERSITE=1
    cd /MarkovModels
    micromamba run -n markovmodels "$@"
